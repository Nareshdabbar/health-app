{
  "expo": {
    "name": "MetaHealth",
    "slug": "meta-health",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/meta_app_logo.png",
    "scheme": "metahealth",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.metahealth.app"
    },
    "android": {
      "package": "com.metahealth.app",
      "adaptiveIcon": {
        "backgroundColor": "#0F172A",
        "foregroundImage": "./assets/images/meta_app_logo.png",
        "backgroundImage": "./assets/images/meta_app_logo.png",
        "monochromeImage": "./assets/images/meta_app_logo.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/meta_app_logo.png"
    },
    "jsEngine": "hermes",
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/meta_splash.png",
          "resizeMode": "contain",
          "backgroundColor": "#0F172A"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 36,
            "targetSdkVersion": 36,
            "minSdkVersion": 24,
            "ndkVersion": "26.1.10909125"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {}
    }
  }
}
